<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <!-- The PuffinMail storefront script and what it calls (visits, signup forms). -->
    <policies>
        <policy id="script-src">
            <values>
                <value id="puffinmail" type="host">my.puffinmail.co</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="puffinmail" type="host">my.puffinmail.co</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
