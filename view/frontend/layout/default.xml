<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- PuffinMail storefront script (website visits, browse abandonment, signup forms). -->
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="puffinmail.storefront"
                   template="PuffinMail_LifeCycle::storefront.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">PuffinMail\LifeCycle\ViewModel\Storefront</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
